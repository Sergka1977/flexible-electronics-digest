# Необязательно: контактная почта для Crossref (вежливый пул запросов).
CROSSREF_MAILTO=

# Необязательно: ключ OpenAlex. Без ключа работает общий свободный доступ,
# который имеет общие лимиты, поэтому ключ снижает риск ограничений.
OPENALEX_API_KEY=

# Файл истории показанных материалов. По умолчанию data/visitor_history.json.
# На нескольких инстансах укажите путь к общему постоянному хранилищу.
DIGEST_HISTORY_FILE=

# Таймаут одного запроса к источнику в секундах.
NEWS_SOURCE_TIMEOUT=8

# Сколько результатов запрашивать на один поисковый запрос источника.
NEWS_SOURCE_PER_QUERY=20
